{{ define "rss_title" }}
    {{ i18n "rss_feed" }}
{{ end }}

{{ define "rss_main" }}
    {{ $authorEmail := or .Site.Params.email .Site.Params.author_email }}
    {{ $authorName := or .Site.Params.author .Site.Params.author_name }}
    {{ range first 10 (where .Site.RegularPages ".Params.rss_hide" "ne" true) }}
        <item>
            <title>{{ .Title }}</title>
            <link>{{ .Param "baseURL" }}{{ .RelPermalink }}</link>
            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 MST" | safeHTML }}</pubDate>
            {{ with $authorEmail }}
                <author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>
            {{end}}
            <guid isPermaLink="false">{{ .RelPermalink }}</guid>
            <description>{{ .Content | html }}</description>
        </item>
    {{ end }}
{{ end }}

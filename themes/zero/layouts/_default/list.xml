{{ define "rss_title" }}
    {{ $currentNode := . }}
    {{ range .Site.Menus.main }}
        {{ if ($currentNode.IsMenuCurrent "main" .) }}
            {{ .Name }}
        {{ else }}
            {{ range .Children }}
                {{ if ($currentNode.IsMenuCurrent "main" .) }}
                    {{ .Name }}
                {{ end }}
            {{ end }}
        {{ end }}
    {{ end }}
{{ end }} 

{{ define "rss_main" }}
    {{ $currentNode := . }}
    {{ $authorEmail := or .Site.Params.email .Site.Params.author_email }}
    {{ $authorName := or .Site.Params.author .Site.Params.author_name }}
    {{ range .Site.Menus.main }}
        {{ if ($currentNode.IsMenuCurrent "main" .) }}
            {{ range first 10 (where (where (where $currentNode.Site.Pages "Section" (path.Base .URL)) "Title" "ne" "") ".Params.rss_hide" "ne" true) }}
                <item>
                    <title>{{ .Title }}</title>
                    <link>{{ .Param "baseURL" }}{{ .RelPermalink }}</link>
                    <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 MST" | safeHTML }}</pubDate>
                    {{ with $authorEmail }}
                        <author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>
                    {{end}}
                    <guid isPermaLink="false">{{ .RelPermalink }}</guid>
                    <description>{{ .Content | html }}</description>
                </item>
            {{ end }}
        {{ else }}
            {{ range .Children }}
                {{ if ($currentNode.IsMenuCurrent "main" .) }}
                    {{ range first 10 (where $currentNode.Pages ".Params.rss_hide" "ne" true) }}
                        <item>
                            <title>{{ .Title }}</title>
                            <link>{{ .Param "baseURL" }}{{ .RelPermalink }}</link>
                            <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 MST" | safeHTML }}</pubDate>
                            {{ with $authorEmail }}
                                <author>{{ . }}{{ with $authorName }} ({{ . }}){{ end }}</author>
                            {{end}}
                            <guid isPermaLink="false">{{ .RelPermalink }}</guid>
                            <description>{{ .Content | html }}</description>
                        </item>
                    {{ end }}
                {{ end }}
            {{ end }}
        {{ end }}
    {{ end }}
{{ end }}
